GROQ_API_KEY=your_groq_api_key_here

# Chat model used by Groq.
GROQ_MODEL=llama-3.3-70b-versatile

# Choose chroma or faiss.
VECTOR_STORE=chroma

# Embedding model downloaded by FastEmbed on first run.
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Retrieval tuning.
CHUNK_SIZE=1000
CHUNK_OVERLAP=150
RETRIEVAL_K=4
